<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>eryph-mcp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>eryph-mcp</ToolCommandName>
    <PackageId>Eryph.Mcp.Server</PackageId>
    <Version>0.1.1</Version>
    <Description>stdio MCP server for eryph: create, run and inspect catlets with the user's eryph client credentials.</Description>
    <Authors>dbosoft</Authors>
    <Company>dbosoft</Company>
    <Product>eryph</Product>
    <Copyright>Copyright (c) 2026 dbosoft</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/eryph-org/eryph-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eryph-org/eryph-mcp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>eryph;mcp;model-context-protocol;catlet;hyper-v;virtualization</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Eryph.Mcp.Tools\Eryph.Mcp.Tools.csproj" />
  </ItemGroup>

</Project>
